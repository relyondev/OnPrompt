{
  "name": "on-prompt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "migration:dry-run": "node scripts/migration-dry-run.mjs"
  },
  "dependencies": {
    "firebase": "^10.8.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.1",
    "firebase-tools": "^15.34.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.5",
    "vitest": "^1.6.1"
  }
}

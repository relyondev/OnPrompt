      "vite.config.ts",
      "tailwind.config.js",
      "postcss.config.js",
      "tsconfig.json",
      "firestore.rules",
      "firebase.json",
      ".firebaserc",
      "audit-report.md",
      "audit-report.json"
    ],
    "src": [
      "index.tsx",
      "index.css",
      "types.ts",
      "App.tsx"
    ],
    "components": [
      "LoginForm.tsx",
      "CategoryGrid.tsx",
      "SearchHeader.tsx",
      "PromptCard.tsx",
      "PromptDetailModal.tsx",
      "PromptForm.tsx",
      "ProjectForm.tsx",
      "CategoryForm.tsx",
      "SettingsModal.tsx",
      "Sidebar.tsx",
      "BottomNav.tsx",
      "StructuredPromptFields.tsx"
    ],
    "services": [
      "firebaseService.ts",

      "googleDriveService.ts",
      "promptPackService.ts"
    ],
    "contexts": [
      "AuthContext.tsx",
      "ThemeContext.tsx"
    ],
    "utils": [
      "storage.ts",
      "settingsStorage.ts",
      "promptAnalysis.ts"
    ]
  }
}
